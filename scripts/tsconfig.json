{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Scripts are run directly by Node (type stripping), tsc only type-checks them.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts"]
}
