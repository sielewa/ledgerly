{
  "name": "gateway",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "tsc -p tsconfig.json && (tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js)",
    "dev:win": "tsc -p tsconfig.json && start /b node --watch --enable-source-maps dist/main.js && tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@ledgerly/proto": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/microservices": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
}
